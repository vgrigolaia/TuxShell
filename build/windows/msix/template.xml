<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="tuxshell"
        Arguments=""
        InstallLocation="C:\Program Files\vgrigolaia\TuxShell">
    </Installer>
    <PackageInformation
        PackageName="TuxShell"
        PackageDisplayName="TuxShell"
        PublisherName="CN=vgrigolaia"
        PublisherDisplayName="vgrigolaia"
        Version="0.1.0.0"
        PackageDescription="SSH connection manager for Linux">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.vgrigolaia.tuxshell"
                Description="SSH connection manager for Linux"
                DisplayName="TuxShell"
                ExecutableName="tuxshell"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>TuxShell</DisplayName>
            <PublisherDisplayName>vgrigolaia</PublisherDisplayName>
            <Description>SSH connection manager for Linux</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="tuxshell.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
